# Credenciais e caminho do terminal MetaTrader 5
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env com senhas reais.

# Caminho opcional do terminal MT5 (Windows). Deixe vazio para usar o terminal padrão.
# Exemplo: C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# Conta de trading (login numérico da conta)
MT5_LOGIN=12345678

# Senha da conta
MT5_PASSWORD=sua_senha_aqui

# Servidor do broker (ex.: MetaQuotes-Demo, BrokerName-Demo)
MT5_SERVER=MetaQuotes-Demo

# Timeout de conexão em milissegundos
MT5_TIMEOUT_MS=60000

# Símbolo padrão para o EA (ex.: EURUSD, XAUUSD)
MT5_SYMBOL=EURUSD

# Timeframe dos candles em minutos (1, 5, 15, 30, 60, 240, 1440...)
MT5_TIMEFRAME_MINUTES=15

# Quantidade de barras a carregar (mínimo automático ~ EMA lenta + ATR + margem)
MT5_BARS=120

# Intervalo do loop do EA em segundos
MT5_POLL_INTERVAL_SEC=5

# true = modo seguro (não envia ordens); false = permite trading real
MT5_DRY_RUN=true

# --- Estratégia: Dual EMA + ATR ---
STRATEGY_EMA_FAST=12
STRATEGY_EMA_SLOW=26
STRATEGY_ATR_PERIOD=14
# Stop = ATR * multiplicador; Take Profit = ATR * multiplicador
STRATEGY_ATR_SL_MULT=1.5
STRATEGY_ATR_TP_MULT=2.5

# --- Gestão de risco ---
# percent = sizing pelo % do equity; fixed = lote fixo
RISK_MODE=percent
RISK_PERCENT=0.5
RISK_FIXED_LOTS=0.01
RISK_MAX_POSITIONS=1
# 0 = desativa o limite de perda diária
RISK_MAX_DAILY_LOSS_PERCENT=2.0
# 0 = desativa filtro de spread (em pontos do símbolo)
RISK_MAX_SPREAD_POINTS=25
# Horário local da máquina (0-23). Deixe VAZIO para desativar o filtro.
RISK_SESSION_START_HOUR=7
RISK_SESSION_END_HOUR=21
# Magic number para identificar ordens deste EA
RISK_MAGIC=9327001
