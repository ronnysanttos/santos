# Credenciais e caminho do terminal MetaTrader 5
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env com senhas reais.

# Caminho opcional do terminal MT5 (Windows). Deixe vazio para usar o terminal padrão.
# Exemplo: C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# Conta de trading (login numérico da conta)
MT5_LOGIN=12345678

# Senha da conta
MT5_PASSWORD=sua_senha_aqui

# Servidor do broker (ex.: MetaQuotes-Demo, BrokerName-Demo)
MT5_SERVER=MetaQuotes-Demo

# Timeout de conexão em milissegundos
MT5_TIMEOUT_MS=60000

# Símbolo padrão para o EA (ex.: EURUSD, XAUUSD)
MT5_SYMBOL=EURUSD

# Timeframe dos candles em minutos (1, 5, 15, 30, 60, 240, 1440...)
MT5_TIMEFRAME_MINUTES=5

# Quantidade de barras a carregar a cada ciclo
MT5_BARS=20

# Intervalo do loop do EA em segundos
MT5_POLL_INTERVAL_SEC=5

# true = modo seguro (não envia ordens); false = permite trading real (não recomendado)
MT5_DRY_RUN=true
