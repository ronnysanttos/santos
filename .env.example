# Ollama (cérebro local) — modelo travado: qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.2
# true = se Ollama estiver offline, usa heurística local (útil em CI / demo)
OLLAMA_ALLOW_FALLBACK=true

# Busca web — travado: DuckDuckGo via ddgs
WEB_SEARCH_MAX_RESULTS=5
# duckduckgo | mock
WEB_SEARCH_BACKEND=duckduckgo

# Guardrails (protocolo de segurança)
MIN_CONFIDENCE=70
DAILY_LOSS_LIMIT_BRL=300
HIGH_IMPACT_PAUSE_MINUTES=15

# Mercado / MT5 (Fase 3)
# auto = tenta MT5 e cai para stub | stub | mt5
MARKET_DATA_MODE=auto
# SEMPRE true no início. Só mude depois de validar em demo.
MT5_DRY_RUN=true
# Exige MT5_DRY_RUN=false E MT5_ALLOW_DEMO_ORDERS=true para enviar ordem real.
MT5_ALLOW_DEMO_ORDERS=false
DEFAULT_TICKER=PETR4

# Credenciais MT5 (Windows + terminal aberto; conta DEMO)
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000
MT5_TIMEFRAME_MINUTES=15
MT5_BARS=220
MT5_VOLUME=0.01
MT5_SL_ATR_MULT=1.5
MT5_TP_ATR_MULT=2.5
MT5_MAGIC=20260919
MT5_RSI_PERIOD=14
MT5_MA_PERIOD=200
MT5_ATR_PERIOD=14
