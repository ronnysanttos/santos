# Ollama (cérebro local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.2
# true = se Ollama estiver offline, usa heurística local (útil em CI / demo)
OLLAMA_ALLOW_FALLBACK=true

# Busca web
WEB_SEARCH_MAX_RESULTS=5
# duckduckgo | mock
WEB_SEARCH_BACKEND=duckduckgo

# Guardrails (protocolo de segurança)
MIN_CONFIDENCE=70
DAILY_LOSS_LIMIT_BRL=300
HIGH_IMPACT_PAUSE_MINUTES=15

# Mercado / MT5 (Fase 3 — stub no MVP)
MARKET_DATA_MODE=stub
MT5_DRY_RUN=true
DEFAULT_TICKER=PETR4
